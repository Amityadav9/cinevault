# Copy to .env and fill in. .env is git-ignored.

# Postgres (matches docker-compose.yml)
POSTGRES_USER=cinevault
POSTGRES_PASSWORD=cinevault
POSTGRES_DB=cinevault
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# TMDB: https://www.themoviedb.org/settings/api  (use the "API Read Access Token")
TMDB_TOKEN=

# LLM (phase 5)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
